<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>ArgonSpriteForge</AssemblyName>
    <RootNamespace>ArgonSpriteForge</RootNamespace>
    <Version>1.0.0</Version>
    <Company>Argon High Studio</Company>
    <Product>Argon Sprite Forge</Product>

    <!-- Single-file self-contained Windows x64 publishing defaults -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.5" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.19.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="static/index.html" LogicalName="ArgonSpriteForge.static.index.html" />
    <EmbeddedResource Include="static/style.css" LogicalName="ArgonSpriteForge.static.style.css" />
    <EmbeddedResource Include="static/app.js" LogicalName="ArgonSpriteForge.static.app.js" />
  </ItemGroup>

</Project>
